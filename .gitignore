# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data and secrets
data/
.env

# ...except the two things in there that must survive a clean checkout.
#
# Locked predictions are forecasts written before kickoff and never rewritten, and the ledger
# records what each experiment decided. Both are worthless if they can quietly disappear or
# change, so they are tracked: git history makes them tamper-evident, which is a stronger
# guarantee than a bucket a later pipeline run could overwrite.
!data/predictions/
!data/predictions/**

# Terraform (used from phase 1C)
.terraform/
*.tfstate
*.tfstate.*

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# web
web/node_modules/
web/.next/
web/out/
# The end-to-end suite builds into its own folder so it never collides with a dev server.
web/out-e2e/
web/public/data/
web/test-results/
web/playwright-report/
web/next-env.d.ts
web/tsconfig.tsbuildinfo
research/__pycache__/
research/*.duckdb
