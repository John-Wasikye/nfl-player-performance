{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data": "node scripts/sync-data.mjs && node scripts/build-research.mjs",
    "dev": "npm run data && next dev",
    "build": "next build",
    "serve": "node scripts/serve-static.mjs out",
    "lint": "eslint",
    "typecheck": "next typegen && node node_modules/typescript-native/bin/tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "research": "node scripts/build-research.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "marked": "^18.0.13",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-native": "npm:typescript@~7.0.2",
    "vitest": "^5.0.1"
  }
}
